{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC, check for updates / restart, and appearance (title bar theme, UI zoom).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom"
  ]
}
