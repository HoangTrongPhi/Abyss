{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "__APP_NAME__",
  "version": "0.1.0",
  "identifier": "__IDENTIFIER__",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:__PORT__",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "__APP_NAME__",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "__BUNDLE_CATEGORY__",
    "shortDescription": "__TAGLINE__",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "__APP_NAME__",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Phineas",
    "copyright": "© __YEAR__ Hoàng Trọng Phi",
    "homepage": "https://github.com/__REPO__"
  },
  "plugins": {
    "updater": {
      "pubkey": "__PUBKEY__",
      "endpoints": [
        "https://github.com/__REPO__/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
