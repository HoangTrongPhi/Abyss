{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Abyss",
  "version": "0.1.0",
  "identifier": "com.phineas.abyss",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Abyss",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f1115",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://raw.githubusercontent.com https://github.com https://*.githubusercontent.com",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Installs, updates and launches Phineas' apps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Abyss",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Phineas",
    "copyright": "© 2026 Hoàng Trọng Phi",
    "homepage": "https://github.com/HoangTrongPhi/Abyss",
    "longDescription": "Abyss installs, updates and launches Phineas' desktop apps (Poseidon and more) and Blender add-ons from one window."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQzgxNjAxMkNEN0E1QzgKUldUSXBkY3NBUmJJM24xMTkxUzl2cVdjNzJvbThXRTJvS0JOMDhRdWh4eGlHM29Yd0lqeWVTbWUK",
      "endpoints": [
        "https://github.com/HoangTrongPhi/Abyss/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
